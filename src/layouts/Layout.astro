---
// Szkielet strony odwzorowujący motyw Astra 4.6 + Elementor (WordPress) 1:1.
// Arkusze CSS to oryginalne pliki motywu/wtyczek skopiowane do public/wp-content
// oraz style inline z <head> zapisane w public/wp-inline (kolejność ma znaczenie).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FacebookBox from '../components/FacebookBox.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  canonical?: string | null;
  meta?: string[][];
  bodyClass: string;
  styles: string[];
  jsonld?: string | null;
  forms?: boolean;
}
const { title, canonical, meta: rawMeta = [], bodyClass, styles, jsonld, forms = false } = Astro.props;
// Podgląd na GitHub Pages (inny base niż "/") nie powinien trafić do Google.
const preview = import.meta.env.BASE_URL !== '/';
// Content-Security-Policy: tylko własne skrypty (bez inline) + Facebook SDK i mapa Google.
// style-src 'unsafe-inline' jest potrzebne, bo markup Elementora ma atrybuty style="".
const csp = [
  "default-src 'self'",
  "script-src 'self' https://connect.facebook.net",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https://*.facebook.com https://*.fbcdn.net",
  "font-src 'self' data:",
  "frame-src https://www.facebook.com https://web.facebook.com https://maps.google.com https://www.google.com",
  "connect-src 'self' https://*.facebook.com",
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'",
].join('; ');
const meta = preview
  ? [['name', 'robots', 'noindex, nofollow'], ...rawMeta.filter(([, key]) => key !== 'robots')]
  : rawMeta;
---
<!doctype html>
<html lang="pl-PL">
<head>
<meta charset="UTF-8" />
<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<title>{title}</title>
{meta.map(([attr, key, content]) => (attr === 'property' ? <meta property={key} content={content} /> : <meta name={key} content={content} />))}
{canonical && <link rel="canonical" href={canonical} />}
{jsonld && <script type="application/ld+json" is:inline set:html={jsonld} />}
{styles.map((href) => <link rel="stylesheet" href={href} media="all" />)}
<link rel="icon" href="/wp-content/uploads/2019/08/cropped-logo_firmy_horse_teleport-1-32x32.png" sizes="32x32" />
<link rel="icon" href="/wp-content/uploads/2019/08/cropped-logo_firmy_horse_teleport-1-192x192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/wp-content/uploads/2019/08/cropped-logo_firmy_horse_teleport-1-180x180.png" />
</head>
<body itemtype="https://schema.org/WebPage" itemscope="itemscope" class={bodyClass}>
<a class="skip-link screen-reader-text" href="#content" title="Skip to content">Skip to content</a>
<div class="hfeed site" id="page">
<Header />
<slot />
<Footer />
</div>
<FacebookBox />
<Lightbox />

<script is:inline src="/js/site.js"></script>
<script is:inline src="/wp-content/themes/astra/assets/js/minified/style.min.js"></script>
{forms && <script is:inline src="/form.js" defer></script>}
</body>
</html>
