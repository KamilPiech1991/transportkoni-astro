---
// Wysuwany boks Facebooka (dawniej wtyczka Aspexi Facebook Like Box).
// Style: public/wp-inline/aspexi-fb-likebox-*.css. jQuery zastąpione czystym JS.
import { site } from '../data/site';
---
<div class="aspexifblikebox">
<div class="aspexi_facebook_button"></div>
<div class="aspexi_facebook_iframe">
<div class="fb-page" data-href={site.facebook} data-width="241" data-height="230" data-hide-cover="false" data-show-facepile="true" data-lazy="false"><div class="fb-xfbml-parse-ignore"><blockquote cite={site.facebook}><a href={site.facebook}>Facebook</a></blockquote></div></div>
</div>
</div>
<div id="fb-root"></div>

<script is:inline src="/js/fb-likebox.js" defer></script>
